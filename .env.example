NANO_API_KEY=
NANO_BASE_URL=https://api.deepseek.com/v1
NANO_MODEL=deepseek-chat
NANO_VERBOSE=true

# Provider-specific keys for the provider/model schema.
NANO_DEEPSEEK_API_KEY=
NANO_OPENAI_API_KEY=
NANO_MOONSHOT_API_KEY=
NANO_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
NANO_GEMINI_API_KEY=

NANO_REASONING_ENABLED=true
NANO_REASONING_EFFORT=medium
NANO_REASONING_MAX_TOKENS=0
NANO_REASONING_EXCLUDE=false

NANO_MAX_FILE_SIZE=10485760
NANO_RESPONSE_TIMEOUT=600s
NANO_HTTP_TIMEOUT=60s

NANO_CONTEXT_MAX_TOKENS=80000
NANO_CONTEXT_COMPRESSION_RATIO=0.25
NANO_CONTEXT_PRESERVE_RECENT_TURNS=6
NANO_CONTEXT_ENABLE_COMPRESSION=true

NANO_MEMORY_API_KEY=
NANO_MEMORY_BASE_URL=https://api.mem0.ai
NANO_MEMORY_ORG_ID=
NANO_MEMORY_PROJECT_ID=
NANO_MEMORY_USER_ID=nano-agent-user
NANO_MEMORY_AGENT_ID=nano-agent

NANO_CONFIRM_DESTRUCTIVE=false
NANO_REDACTION_SENSITIVE_KEYS=password,passwd,secret,api_key,apikey,token,access_token,authorization,auth,cookie,set-cookie,session,private_key,client_secret
NANO_REDACTION_ADDITIONAL=[{"name":"github_token","regex":"ghp_[A-Za-z0-9]{36,}","replacement":"[REDACTED_GH_TOKEN]"},{"name":"aws_access_key_id","regex":"AKIA[0-9A-Z]{16}","replacement":"[REDACTED_AWS_AK]"},{"name":"aws_secret_access_key","regex":"(?i)aws(.{0,20})?secret(.{0,20})?key[^\\S\\r\\n]*[:=][^\\S\\r\\n]*([A-Za-z0-9/+=]{40})","replacement":"[REDACTED_AWS_SK]"}]
# Comma-separated additions to the built-in shell confirmation lists.
NANO_SENSITIVE_READ_PATHS=/tmp/secret,/private/team-secrets
NANO_ARBITRARY_EXEC_COMMANDS=python:-m,node:--print

NANO_SANDBOX_ENABLED=true
NANO_SANDBOX_ALLOWED_PATHS=/home/ubuntu/workspaces,/tmp,/var/tmp
NANO_SANDBOX_BLOCKED_PATHS=/etc/passwd,/etc/shadow,/etc/sudoers,/home/ubuntu/.ssh,/home/ubuntu/.aws,/root,/boot,/sys,/proc
NANO_SANDBOX_READ_ONLY_PATHS=/usr/share/doc,/home/ubuntu/reference
NANO_SANDBOX_MAX_FILE_SIZE=52428800
NANO_SANDBOX_ALLOW_SYMLINKS=false
NANO_SANDBOX_ALLOW_HIDDEN_FILES=false

SERPER_API_KEY=
TAVILY_API_KEY=

NANO_ENABLE_MCP=true
NANO_MCP_DEEPWIKI_AUTHORIZATION=
NANO_MCP_GITHUB_TOKEN=
NANO_MCP_DEFAULT_TRANSPORT=stdio
NANO_MCP_TIMEOUT=180s
NANO_MCP_MAX_RETRIES=3
NANO_MCP_ENABLE_HEALTH_CHECK=true
NANO_MCP_HEALTH_CHECK_INTERVAL=30s
NANO_MCP_HEALTH_CHECK_TIMEOUT=10s

NANO_DAEMON_PORT=8080
NANO_DAEMON_HOST=0.0.0.0
NANO_DAEMON_PID_FILE=/home/ubuntu/nano-agent/.nano/daemon.pid
NANO_DAEMON_LOG_FILE=/home/ubuntu/nano-agent/.nano/daemon.log
NANO_DAEMON_ENABLE_CORS=true
NANO_DAEMON_API_KEY=
NANO_DAEMON_TLS_CERT_FILE=
NANO_DAEMON_TLS_KEY_FILE=

OSS_ENABLED=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_DEFAULT_BUCKET=nano-agent
OSS_REGION=cn-shenzhen
OSS_TIMEOUT=60

IMAGE_API_KEY=
IMAGE_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=
SEEDREAM_API_KEY=
SEEDREAM_IMAGE_MODEL=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

NANO_ENABLED_TOOLS=
NANO_DISABLED_TOOLS=
