# Nano Code Agent Configuration
# Copy to .nano.yaml (project) or ~/.config/nano/config.yaml (global)
# Config resolution: --config flag > project .nano.yaml > global ~/.config/nano/config.yaml
# Note: Environment variables (NANO_*, SERPER_API_KEY, TAVILY_API_KEY) override values from config files.

# Core LLM Configuration (legacy schema; still supported)
api_key: "your-llm-api-key"   # Can be set via NANO_API_KEY env var
base_url: "https://api.deepseek.com/v1"
model: "deepseek-chat"
verbose: false

# Multi-provider model routing (recommended schema)
# When providers is configured, provider/model references below take precedence
# over legacy api_key/base_url/model endpoint fields above.
# Prefer api_key_env to avoid committing plaintext API keys.
# model: "deepseek/deepseek-chat"
# fallbacks:
#   - "openai/gpt-4.1"
#   - "moonshot/kimi-k2"
# providers:
#   deepseek:
#     api_key_env: NANO_DEEPSEEK_API_KEY
#   openai:
#     api_key_env: OPENAI_API_KEY
#   moonshot:
#     api_key_env: MOONSHOT_API_KEY
#     base_url: "https://api.moonshot.cn/v1"

# Built-in pprof (local-only listener)
enable_pprof: true
pprof_port: 6060

# System Limits and Timeouts
max_file_size: 10485760  # 10MB in bytes
response_timeout: 120s   # LLM response timeout
http_timeout: 60s        # HTTP client timeout

# Context Management
context:
  max_tokens: 80000
  compression_ratio: 0.25
  preserve_recent_turns: 6
  enable_compression: true

# Reasoning Configuration (for o1 models)
reasoning:
  enabled: false           # Enable reasoning mode for supported models
  effort: "medium"         # Reasoning effort level: low, medium, high
  max_tokens: 0           # Max reasoning tokens (0 = model default)
  exclude: false          # Exclude reasoning tokens from response

# Advanced LLM resilience configuration
advanced:
  circuit_breaker:
    max_retries: 3
    base_delay_ms: 2000
    max_delay_ms: 60000
    open_timeout_ms: 60000
    exclude_non_failback: true  # 非 failback 错误（认证/配额/context overflow/取消/格式错误）不计入熔断失败
    truncation_detection: true  # 检测 finish_reason=length，并通过 stream event metadata 暴露 truncated/finish_reason

# Memory System Configuration (Mem0 Integration)
# Mem0 is an AI-native memory layer for AI applications that provides persistent, contextual memory
# with advanced vector search, graph search, adaptive learning, and multi-modal capabilities
# Features intelligent semantic understanding and contextual associations for superior memory retrieval
# Sign up at https://mem0.ai to get your API key
memory:
  api_key: "your-mem0-api-key"        # Get from https://mem0.ai/dashboard
  base_url: "https://api.mem0.ai"     # Mem0 API base URL
  user_id: "nano-agent-user"          # Unique identifier for the user
  org_id: ""                          # Organization ID (optional)
  project_id: ""                      # Project ID (optional)
  agent_id: ""                        # Agent ID (optional, auto-generated from subagent selection if not set)

# Safety Settings
confirm_destructive: false
# Additional sensitive shell-read paths that require confirmation.
# Built-in defaults already include nano config, system credential paths, and common project secret files.
# sensitive_read_paths:
#   - "/tmp/secret"
#   - "~/.claude"
# Additional command:flag patterns that require confirmation for interpreter/eval-style execution.
# Built-in defaults already include python:-c, python3:-c, node:-e, bash:-c, sh:-c, perl:-e, ruby:-e, etc.
# arbitrary_exec_commands:
#   - "python:-m"
#   - "node:--print"

# Turn Execution Control
turn:
  max_duration: 30m  # Maximum duration for a single turn (default: 30m)

# Ralph-loop continuation from Stop hooks
hooks:
  ralph:
    enabled: true              # Set false to prevent Stop hook block decisions from restarting turns
    max_iterations: 10         # Soft maximum per session loop
    hard_max_iterations: 50    # Safety cap


# Sub-agents Configuration (Expert System)
# Define specialized sub-agents that can be invoked with @agent-name syntax
#
# IMPORTANT: Expert Trigger Syntax
#   - Use @kebab-case-name to invoke an expert (e.g., "@coder help me debug")
#   - Names are automatically converted to kebab-case (coder -> coder, myAgent -> my-agent)
#   - LLM cannot directly call experts; only users can trigger them with @ syntax
#
# Built-in Experts (always available):
#   @investigator - Read-only codebase exploration and analysis
#   @help         - Answers questions about nano-agent CLI from documentation
#   @generalist   - General-purpose agent with full tool access
#
# Custom experts can be defined in:
#   - Project:  .nano/agents/*.md (highest priority)
#   - User:     ~/.config/nano/agents/*.md
#
# Usage examples:
#   - "@coder help me debug this function"
#   - "@investigator find all error handling code"
#   - "@help how do I configure MCP servers?"
#
# Sub-agent model routing:
#   - `model` can use provider/model references from the providers block above.
#   - If omitted, the sub-agent inherits the lead agent primary model and fallbacks.
#   - Project profiles in .nano/agents/*.md may declare their own `fallbacks` list.
#
# Example .nano/agents/reviewer.md frontmatter:
#   ---
#   model: deepseek/deepseek-chat
#   fallbacks: [openai/gpt-4.1]
#   ---
sub_agents:
  - agent_name: "coder"
    system_prompt: "You are a senior software engineer and programming expert, proficient in multiple programming languages and development frameworks. You excel at code design, architecture planning, debugging, and performance optimization. You can write high-quality, maintainable code following best practices and design patterns. You are familiar with modern development tools, version control, test-driven development, and continuous integration."
    when_to_use: "Use for coding tasks, debugging, code reviews, and technical implementation"
    model: "gpt-4o"
    # Wildcard patterns are supported in allowed_tools:
    # - "*" matches any tool name
    # - "mcp_*" matches all MCP tools (e.g., mcp_filesystem_read, mcp_git_status)
    # - "web_*" matches all web-related tools
    # - "file_*" matches all file operation tools
    # - "?" matches any single character
    allowed_tools: ["web_search", "workspace_manager", "write_file", "read_file", "mcp_*", "mem0_memory"]
    auto_save_memory: true                 # Auto-save conversation to Mem0 (requires memory tools in allowed_tools)
    enabled: true                          # Enable this sub-agent

  - agent_name: "writer"
    system_prompt: "You are a professional writer and content creator, skilled in various forms of writing including articles, documentation, creative writing, and technical communication. You excel at creating clear, engaging, and well-structured content tailored to different audiences and purposes."
    when_to_use: "Use for writing tasks, documentation, articles, content creation, and text editing"
    model: "gpt-4o-mini"
    # Example using wildcard patterns for tool filtering
    allowed_tools: ["web_search", "workspace_manager", "write_file", "read_file", "mcp_web_*", "mem0_memory"]
    auto_save_memory: false                # Disable auto-save of conversation
    enabled: true                          # Enable this sub-agent

  - agent_name: "analyst"
    system_prompt: "You are a data analyst and research specialist, expert in analyzing information, creating reports, and extracting insights from data. You excel at statistical analysis, data visualization, market research, and presenting findings in clear, actionable formats."
    when_to_use: "Use for data analysis, research, reporting, and analytical tasks"
    model: "gpt-4o"
    allowed_tools: ["web_search", "workspace_manager", "write_file", "read_file", "mem0_memory", "task_done"]
    auto_save_memory: false                # Disable auto-save of conversation
    enabled: true                          # Enable this sub-agent

  - agent_name: "穿越小说家"
    system_prompt: "你是一位擅长穿越小说的作家，专注于将现代元素融入历史背景，创作引人入胜的时间旅行故事。你善于描绘不同时代的历史细节，构建合理的穿越机制，以及刻画角色在异时空中的成长与挣扎。在创作中，你会注重历史准确性与情节张力的平衡，打造既有知识性又富有娱乐性的穿越故事。"
    when_to_use: "当任务涉及创作穿越时空的小说情节、历史与现代融合的叙事或时间旅行主题时激活"
    model: "gpt-4"
    allowed_tools: ["web_search", "workspace_manager", "write_file", "read_file", "mem0_memory", "task_done"]
    auto_save_memory: true                 # Auto-save conversation to Mem0
    enabled: true                          # Enable this sub-agent

  - agent_name: "玄幻小说家"
    system_prompt: "你是一位玄幻小说大师，精通构建宏大的奇幻世界、复杂的力量体系和史诗般的英雄之旅。你擅长设计独特的修炼体系、神秘的法则与秩序，以及丰富多样的种族与文明。你的创作充满东方玄学与西方奇幻的融合元素，能够编织出错综复杂的情节与扣人心弦的战斗场景，同时赋予角色深刻的成长与蜕变。"
    when_to_use: "当任务需要创作玄幻世界、魔法系统、修仙体系或奇幻冒险故事时激活"
    model: "claude-3-opus"
    allowed_tools: ["web_search", "workspace_manager", "write_file", "read_file", "mem0_memory", "task_done"]
    auto_save_memory: true                 # Auto-save conversation to Mem0
    enabled: true                          # Enable this sub-agent

# Tool Configuration
enabled_tools: []
disabled_tools: []

# Web Search API Keys
web_search_api_keys:
  serper: ""
  tavily: ""
  duckduckgo: ""

# Image Generator Configuration
# Configure image generation service settings
image_generator:
  providers:
    - provider: "openrouter"
      model: "black-forest-labs/flux-schnell"
      api_key: ""
      base_url: ""
      enabled: true
    - provider: "seedream"
      model: "sdxl"
      api_key: ""
      base_url: ""
      enabled: true

# MCP (Model Context Protocol) Configuration
enable_mcp: false
mcp:
  enable_client: true
  servers: []  # See examples below
  default_transport: "stdio"
  timeout: 30s
  max_retries: 3
  enable_auth: false
  auth_tokens: {}
  tls:
    enabled: false
    cert_file: ""
    key_file: ""
    ca_file: ""
    skip_verify: false

# Daemon Mode Configuration
# Note: pid_file/log_file default to ~/.nano/daemon.pid and ~/.nano/daemon.log if empty
daemon:
  port: 8080
  host: "127.0.0.1"
  pid_file: ""
  log_file: ""
  enable_cors: true
  api_key: ""  # Optional API key for daemon authentication
  tls_cert_file: ""
  tls_key_file: ""
  # Policy for handling ActionConfirm decisions when no approval handler is present
  # Options: "allow" (auto-approve), "block" (reject), "allowlist" (check allowlisted_tools)
  # Default: "allow" for backward compatibility
  confirm_policy: "allow"
  # List of tools to auto-approve when confirm_policy is "allowlist"
  allowlisted_tools: []
  # Examples:
  # allowlisted_tools:
  #   - "read_file"
  #   - "run_shell_command"
  #   - "web_search"

# Mailbox Configuration
# Multi-agent asynchronous message passing system for sub-agent communication
# Enables structured communication between parent and child agents during fork-based execution
# Backend options:
#   - "memory": In-memory storage (default for CLI mode, not persistent across restarts)
#   - "file": File-based storage (recommended for daemon mode, supports crash recovery)
mailbox:
  enabled: false                # Enable/disable mailbox system
  backend: "memory"             # Storage backend: "memory" or "file"
  root_dir: ""                  # Root directory for file backend (default: ~/.nano-agent/mailbox)
  ttl_days: 7                   # Message time-to-live in days (expired messages auto-cleaned)
  max_per_agent: 1000           # Maximum messages per agent inbox (oldest dropped when exceeded)
  max_body_kb: 16               # Maximum message body size in KB
  ack_timeout_sec: 10           # Timeout for acknowledging drained messages (seconds)
  injection_limit: 5            # Maximum messages injected per turn
  injection_max_kb: 4           # Maximum total size of injected messages per turn (KB)
  guidance_prompt_enabled: true # Include guidance text in mailbox injection
  janitor_interval_sec: 60      # Janitor cleanup interval in seconds (0 = disabled, default: 60)

# Watcher Configuration
# Event-driven monitoring rules that poll external sources at regular intervals
# and trigger agent commands when matching events are detected.
# Supported sources:
#   - "shell": runs a shell command and parses stdout as events (JSON array or plain lines)
#   - "aone": Aone MR/CI events (requires Aone CLI installed; stub by default)
watcher:
  enabled: false
  state_dir: ""   # Defaults to ~/.nano
  rules:
    # Example: monitor a shell script for changes
    # - id: check-build-status
    #   source: shell
    #   shell_command: "./scripts/check-build.sh"
    #   command: "构建状态异常，请检查: {{.OUTPUT}}"
    #   interval: 5m
    #   timeout: 10m
    #
    # Example: monitor Aone for new merge requests (requires Aone CLI)
    # - id: review-new-mrs
    #   source: aone
    #   event: new_mr
    #   filter: "repo:aone/a1 state:opened"
    #   command: "评审 MR {{.MR_URL}}: {{.MR_TITLE}}"
    #   interval: 5m
    #   timeout: 30m

# Sandbox Configuration (Only effective in daemon mode)
# File system access control to restrict agent operations to specific paths
sandbox:
  enabled: false  # Enable/disable sandbox protection
  allowed_paths:   # Paths where agent can read/write files
    - "/home/user/workspace"
    - "/home/user/projects"
    - "/tmp"
    - "/var/tmp"
  blocked_paths:   # Paths that are completely forbidden
    - "/etc/passwd"
    - "/etc/shadow"
    - "/etc/sudoers"
    - "/home/user/.ssh"
    - "/home/user/.aws"
    - "/root"
    - "/boot"
    - "/sys"
    - "/proc"
  readonly_paths:  # Paths that can only be read, not modified
    - "/usr/share/doc"
    - "/home/user/reference"
  hidden_paths:    # Paths that are hidden from agent visibility
    - "/home/user/.cache"
    - "/home/user/.local/share"
  max_file_size: 52428800  # Maximum file size in bytes (50MB)

# MCP Server Examples
# To enable MCP, set enable_mcp: true and configure servers:
# Supported transport types: stdio, streamable, inmemory
# mcp:
#   servers:
#     - name: "filesystem"
#       command: ["npx", "@modelcontextprotocol/server-filesystem", "/path"]
#       transport: "stdio"
#     - name: "git"
#       command: ["npx", "@modelcontextprotocol/server-git", "--repository", "."]
#       transport: "stdio"
#     - name: "web-service"
#       url: "https://api.example.com/mcp"
#       transport: "streamable"
#       headers:
#         Authorization: "Bearer your-token"

# Environment Variables Alternative
# See .env.example for supported environment variable configuration

# Permission Mode Configuration
# Controls how tool-execution confirmations are handled.
# Modes:
#   "default"     - Ask for confirmation for every tool that requires it (standard behaviour)
#   "acceptEdits" - Automatically approve filesystem write/edit tools; shell commands still ask
#   "yolo"        - Skip ALL permission checks (use with caution!)
# permission_mode: "default"

# Pre-defined session allowlist rules (applied at startup)
# Each entry follows the "ToolName" or "ToolName(specifier)" format with glob support.
# Rules added here are active for the entire session without further prompting.
# Examples:
# allowed_rules:
#   - "read_file"              # Allow all file reads without confirmation
#   - "Bash(git *)"            # Allow all git commands
#   - "write_file(*.go)"       # Allow writing Go source files
#   - "Bash(npm run *)"        # Allow npm run scripts
#   - "file_*"                 # Allow all tools whose name starts with file_
